# FastAPI
APP_NAME="AURA Backend"
APP_ENV=local
LOG_LEVEL=INFO

# RDS PostgreSQL
# Example:
# DATABASE_URL=postgresql+psycopg://aura_admin:YOUR_PASSWORD@aura-dev-postgres-1.xxxxxx.ap-northeast-2.rds.amazonaws.com:5432/aura_dev?sslmode=require
DATABASE_URL=

# Cognito
AWS_REGION=ap-northeast-2
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_REQUIRED_TOKEN_USE=id

# Local-only escape hatch. Keep false outside local development.
AUTH_LOCAL_BYPASS=false
AUTH_LOCAL_SUB=local-user-sub
AUTH_LOCAL_EMAIL=local@example.com
AUTH_LOCAL_NAME="Local User"

# S3 upload
S3_BUCKET=
CLOUDFRONT_BASE_URL=
PRESIGNED_UPLOAD_EXPIRES_SECONDS=900

# Bedrock analysis
BEDROCK_ENABLED=false
BEDROCK_MODEL_ID=global.amazon.nova-2-lite-v1:0
BEDROCK_MAX_TOKENS=2200
BEDROCK_TEMPERATURE=0.2
BEDROCK_INCLUDE_IMAGE=true
BEDROCK_FALLBACK_TO_MOCK=true

