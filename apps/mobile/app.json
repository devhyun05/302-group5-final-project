{
    "expo":  {
                 "name":  "AURA",
                 "slug":  "ai-ar-makeup-guide",
                 "version":  "0.1.0",
                 "orientation":  "portrait",
                 "platforms":  [
                                   "ios"
                               ],
                 "scheme":  "aiarmakeup",
                 "userInterfaceStyle":  "light",
                 "extra":  {
                               "router":  {
                                              "root":  "app"
                                          }
                           },
                 "ios":  {
                             "supportsTablet":  true,
                             "bundleIdentifier":  "com.aiarmakeupguide.mobile"
                         },
                 "plugins":  [
                                 "expo-status-bar",
                                 [
                                     "expo-camera",
                                     {
                                         "cameraPermission":  "AURA는 얼굴 촬영과 AI 메이크업 분석 미리보기를 위해 카메라를 사용합니다."
                                     }
                                 ],
                                 [
                                     "expo-image-picker",
                                     {
                                         "photosPermission":  "AURA는 사용자가 선택한 사진으로 AI 메이크업 분석을 제공하기 위해 사진 보관함을 사용합니다."
                                     }
                                 ],
                                 "expo-secure-store"
                             ]
             }
}
