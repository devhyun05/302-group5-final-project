{
    "expo":  {
                 "name":  "AURA",
                 "slug":  "ai-ar-makeup-guide",
                 "version":  "0.1.0",
                 "orientation":  "portrait",
                 "platforms":  [
                                   "ios"
                               ],
                 "scheme":  "aiarmakeup",
                 "userInterfaceStyle":  "light",
                 "extra":  {
                               "router":  {
                                              "root":  "app"
                                          }
                           },
                 "ios":  {
                            "icon": "./assets/aura.icon",
                             "supportsTablet":  true,
                             "bundleIdentifier":  "com.aurastyleguide.mobile"
                         },
                 "plugins":  [
                                 "expo-status-bar",
                                 [
                                     "expo-secure-store",
                                     {
                                         "faceIDPermission":  false
                                     }
                                 ]
                             ]
             }
}
